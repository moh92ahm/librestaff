# Database Configuration
# For local: postgresql://user:password@localhost:5432/database_name
# For Docker Compose deployment, use the db service hostname:
# postgresql://librestaff_user:librestaff_pass@db:5432/librestaff_db
DATABASE_URL=postgresql://librestaff_user:librestaff_pass@127.0.0.1:5432/librestaff_db
POSTGRES_USER=librestaff_user
POSTGRES_PASSWORD=librestaff_pass
POSTGRES_DB=librestaff_db

# Application Secrets (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here-min-32-chars
# Required only to authorize creation of the first administrator.
SETUP_SECRET=your-separate-random-setup-secret
NEXTAUTH_URL=http://localhost:3000
# Enable only behind a trusted proxy that overwrites X-Real-IP/X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Protected Job Endpoints
# Required for /api/jobs/* routes. Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret

# Public URLs
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Remote Deployment
# Keep "librestaff" to build locally, or use ghcr.io/moh92ahm/librestaff.
CONTAINER_IMAGE=librestaff
IMAGE_TAG=latest
COMPOSE_PROJECT_NAME=librestaff_prod
NGINX_SERVER_NAME=librestaff.example.com
NGINX_CERT_NAME=librestaff.example.com

# File Upload Configuration
MEDIA_STORAGE_DIR=./storage/media
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Email Settings
# Required for encrypting SMTP secrets saved from /settings/email.
# Generate with: openssl rand -base64 32
EMAIL_SETTINGS_ENCRYPTION_KEY=your-32-byte-email-settings-key

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# pnpm
.pnpm-debug.log*

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env
.env.production
.env.development
/server\ envs

# Media uploads - ignore all files in public/media except .gitkeep
/public/media/*
!/public/media/.gitkeep
/storage/

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/


# Docs
/docs/
/docs/*
!/docs/
!/docs/announcement-system-guide.md
!/docs/deployment/
!/docs/deployment/**

/generated/prisma
